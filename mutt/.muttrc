# Paths ----------------------------------------------
set folder           = ~/.mail               # mailbox location
set alias_file       = ~/.mutt/alias         # where to store aliases
set header_cache     = ~/.mutt/cache/headers # where to store headers
set message_cachedir = ~/.mutt/cache/bodies  # where to store bodies
set certificate_file = ~/.mutt/certificates  # where to store certs
set mailcap_path     = ~/.mutt/mailcap       # entries for filetypes
set tmpdir           = ~/.mutt/temp          # where to keep temp files
#set signature       = ~/.mutt/sig           # no sig file ships here; enable once one exists

# Basic Options --------------------------------------
set wait_key = no        # shut up, mutt
set mbox_type = Maildir  # mailbox type
set timeout = 3          # idle time before scanning
set mail_check = 0       # minimum time between scans
unset move               # gmail does that
set delete               # don't ask, just do
unset confirmappend      # don't ask, just do!
set quit                 # don't ask, just do!!
unset mark_old           # read/new is good enough for me
set beep_new             # bell on new mails
set pipe_decode          # strip headers and eval mimes when piping
set thorough_search      # strip headers and eval mimes before searching

# Performance Tuning
folder-hook . 'set read_inc=1000'

# Sidebar --------------------------------------
set sidebar_visible = yes
set sidebar_format = "%D%?F? [%F]?%* %?N?%N/?%S"
set mail_check_stats
# %D above rather than %B: %B is the raw mailbox name, which for the notmuch
# searches below is the whole URL, so the sidebar showed "query=tag:unre"
# instead of "Unread". %D is the descriptive name -- the label given to
# named-mailboxes -- and falls back to the mailbox name for plain Maildirs.
#
# Those Maildirs all begin with the same 25-character `jonathanwallace-gmail.com/`
# prefix, so without short_path the one distinguishing part of the name is
# exactly what gets truncated away.
set sidebar_short_path
set sidebar_width = 22

# Status Bar -----------------------------------------
set status_chars  = " *%A"
set status_format = "───[ Folder: %f ]───[%r%m messages%?n? (%n new)?%?d? (%d to delete)?%?t? (%t tagged)? ]───%>─%?p?( %p postponed )?───"

# Header Options -------------------------------------
ignore *                                # ignore all headers
unignore from: to: cc: date: subject:   # show only these
unhdr_order *                           # some distros order things by default
hdr_order from: to: cc: date: subject:  # and in this order

# Account Settings -----------------------------------

# Default inbox.
set spoolfile = "+jonathanwallace-gmail.com/INBOX"

# Alternate email addresses.
#alternates sjl@pculture.org still\.?life@gmail.com steve@ladyluckblues.com steve@pculture.org

# Mailboxes to show in the sidebar.
mailboxes +jonathanwallace-gmail.com/INBOX \
          +jonathanwallace-gmail.com/archive \
          +jonathanwallace-gmail.com/sent \
          +jonathanwallace-gmail.com/drafts \
          +jonathanwallace-gmail.com/flagged

# Notmuch --------------------------------------------
# Gmail's labels never make it over IMAP -- mbsync writes each message to disk
# with no record of which ones it carried -- so `mail-labels` pulls them from
# Gmail's X-GM-RAW extension and applies them as gmail/-prefixed notmuch tags.
# Everything below is what surfaces those tags inside neomutt. Without it the
# notmuch database mailsync has been maintaining all along stays invisible
# here: neomutt only ever opens the plain Maildir directories listed above.

# Absolute path required -- unlike `folder` above, a leading ~ is rejected
# outright. $HOME does get expanded, which keeps this off a hard-coded
# /home/jrw and portable to the mac.
set nm_default_url = "notmuch://$HOME/.mail/jonathanwallace-gmail.com"

# Mirrors [search] exclude_tags in ~/.notmuch-config, so the same query returns
# the same messages here and on the command line.
set nm_exclude_tags = "deleted spam"

# The 5s default is a cold-cache gamble on a database this size; All Mail alone
# is heading for 40k messages.
set nm_open_timeout = 30

# Saved searches, listed in the sidebar beneath the Maildir folders. All
# three work today, and each one crosses folder boundaries in a way no
# Maildir entry above can -- a `flagged` search is left out precisely
# because the Maildir folder of that name already is one.
#
# Label-backed searches need `mail-labels` to have run first, since until
# then no gmail/ tag exists for a query to match, and then take the same
# shape:
#
#   named-mailboxes "Taxes" "notmuch://?query=tag:gmail/2020-taxes"
#
named-mailboxes "Attachments" "notmuch://?query=tag:attachment"
named-mailboxes "Unread"      "notmuch://?query=tag:unread"
named-mailboxes "Last 7 days" "notmuch://?query=date:7d.."

# X is the one that earns its keep: it prompts for any notmuch query and opens
# the results as a folder, so a label is reachable without a sidebar entry of
# its own. L edits tags on the selected message. Both are notmuch-only and do
# nothing in a Maildir folder.
bind index,pager X   vfolder-from-query
bind index,pager L   modify-labels
bind index,pager \Ct entire-thread

# Index View Options ---------------------------------
set date_format = "%m/%d"
# %g appends the message's notmuch tags, which is where gmail/ labels show
# up once mail-labels has run. Right-justified with %> because tag lists
# vary wildly in length -- inline, they would start every subject in a
# different column.
set index_format = "[%Z]  %D  %-20.20F  %s %> %g"
set sort = threads                         # like gmail
set sort_aux = reverse-last-date-received  # like gmail
set uncollapse_jump                        # don't collapse on an unread message
set sort_re                                # thread based on regex
set reply_regexp = "^(([Rr][Ee]?(\[[0-9]+\])?: *)?(\[[^]]+\] *)?)*"

# Index Key Bindings ---------------------------------
#bind index gg       first-entry
bind index G        last-entry

bind index R        group-reply
bind index <tab>    sync-mailbox
bind index <space>  collapse-thread

# Ctrl-R to mark all as read
macro index \Cr "T~U<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" "mark all messages as read"

# Sync email. mailsync runs mbsync and then refreshes the notmuch index --
# mbsync has no postsynchook, so the two are stitched together in the script.
macro index O "<shell-escape>mailsync<enter>"            "sync all mail"
macro index o "<shell-escape>mailsync gmail-inbox<enter>" "sync inbox only"

# Saner copy/move dialogs
macro index C "<copy-message>?<toggle-mailboxes>" "copy a message to a mailbox"
macro index M "<save-message>?<toggle-mailboxes>" "move a message to a mailbox"

# Sidebar Navigation ---------------------------------
bind index,pager <down>   sidebar-next
bind index,pager <up>     sidebar-prev
bind index,pager <right>  sidebar-open

# Pager View Options ---------------------------------
set pager_index_lines = 10 # number of index lines to show
set pager_context = 3      # number of context lines to show
set pager_stop             # don't go to next message automatically
set menu_scroll            # scroll in menus
set tilde                  # show tildes like in vim
unset markers              # no ugly plus signs

set quote_regexp = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"
alternative_order text/plain text/enriched text/html

# Prefer text/plain above, but most Gmail mail is html-only -- auto_view runs
# those through the copiousoutput w3m entry in ~/.mutt/mailcap so they render
# in the pager instead of arriving as an unviewable attachment.
auto_view text/html

# Pager Key Bindings ---------------------------------
bind pager k  previous-line
bind pager j  next-line
#bind pager gg top
bind pager G  bottom

bind pager R  group-reply

# View attachments properly.
bind attach <return> view-mailcap

macro pager \Cu "|urlview<enter>" "call urlview to open links"


# Compose View Options -------------------------------
set realname = "Jonathan Wallace"    # who am i?
set envelope_from                    # which from?
set sig_dashes                       # dashes before sig
set edit_headers                     # show headers when composing
set fast_reply                       # skip to compose when replying
set askcc                            # ask for CC:
set fcc_attach                       # save attachments with the body
unset mime_forward                   # forward attachments as part of body
set forward_format = "Fwd: %s"       # format of subject when forwarding
set forward_decode                   # decode when forwarding
set attribution = "On %d, %n wrote:" # format of quoting header
set reply_to                         # reply to Reply to: field
set reverse_name                     # reply as whomever it was to
set include                          # include message in replies
set forward_quote                    # include message in forwards

set editor = "vim"        # Use terminal Vim to compose email.


set from      = "jonathan.wallace@gmail.com"
set sendmail  = "msmtp -a jonathanwallace"   # resolved on PATH, not a fixed prefix
set sendmail_wait = 0
unset record

