[user]
	name = Jonathan R. Wallace
	email = jonathan.wallace@gmail.com
	# signingkey lives in .gitconfig-{linux,macos,windows}: each machine signs
	# with its own key. It must be set there, not here, because those files are
	# included further down and git config is last-wins.
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = true
[alias]
	ds = diff --staged --color-moved
	st = status
	ci = commit -v
	co = checkout
	br = !git checkout $(git branch | cut -c 3- | awk '{print $1}' | fzf +m --preview 'git show --color=always {}')
	ctags = !.git/hooks/ctags
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --color-moved
	pr = !sh -c 'git log $0..next-release --ancestry-path --merges --oneline | tail -1'
	find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 -s | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
	show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"
[core]
	autocrlf = input
	pager = delta --light
	editor = vim
	# Performance optimizations for WSL2
	fscache = true
	preloadIndex = true
	fileMode = false
	untrackedCache = true
[feature]
	manyFiles = true
[index]
	threads = true
[apply]
	whitespace = nowarn
[pack]
	threads = 0
[diff]
	renamelimit = 0
	compaction-heuristic = true
	noprefix = true
	tool = p4mergetool
[github]
	user = wallace
	;token = <token_here>

[init]
	templatedir = ~/.git_template
	defaultBranch = main
[rerere]
	enabled = true
[mergetool]
  prompt = false
	keepBackup = false
[mergetool "meld"]
  cmd = $HOME/bin/meldmerge $BASE $LOCAL $REMOTE $MERGED
[push]
	default = simple
[pull]
  default = current
	rebase = merges
[hub]
  protocol = ssh
[rebase]
	autostash = true
	autosquash = true
[stash]
	showPatch = true
[includeIf "gitdir:/Users/"]
  path = ~/.gitconfig-macos
[includeIf "gitdir:/home/"]
  path = ~/.gitconfig-linux
[includeIf "gitdir:C:/"]
  path = ~/.gitconfig-windows
[include]
  path = ~/.dotoverrides/gitconfig
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[merge]
	tool = p4mergetool
[mergetool "p4mergetool"]
	cmd = /Applications/p4merge.app/Contents/Resources/launchp4merge $PWD/$BASE $PWD/$REMOTE $PWD/$LOCAL $PWD/$MERGED
	trustExitCode = false
[difftool "p4mergetool"]
	cmd = /Applications/p4merge.app/Contents/Resources/launchp4merge $LOCAL $REMOTE
# --- Commit signing -------------------------------------------------------
#
# Signing runs through 1Password's SSH agent, so the private key stays in the
# vault and each signature is approved there.
#
# ORDER MATTERS, and it is the opposite of ssh_config: git config takes the
# LAST value it sees, and the includeIf lines above pull in the per-OS file.
# So anything a per-OS file needs to override must NOT be repeated below this
# point — it would win over the include. That is why 'program' and
# 'signingkey' appear only in .gitconfig-linux / -macos / -windows: the helper
# binary is at a different path on every platform, and each machine signs with
# its own key.
[gpg]
	format = ssh
[gpg "ssh"]
	# Lets 'git log --show-signature' verify locally instead of reporting no
	# signature. Same path on every platform; the file is stowed by the ssh
	# package.
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgSign = true
