# SSH client configuration. Managed by dotfiles (stow package: ssh).
#
# ORDER IS LOAD-BEARING, and it runs opposite to most config formats:
# ssh_config takes the FIRST value it finds for a keyword and ignores every
# later one. So the most specific source is Included at the top, and the
# shared defaults sit at the bottom where they only fill in what nothing
# above has already decided.
#
# A sharper rule, learned the hard way: Match gates which settings APPLY,
# not what gets PARSED. A file Included inside a Match block whose predicate
# is false is still read and syntax-checked, and a single unrecognised
# keyword is fatal — ssh then refuses to run at all, for every host, not
# just the one you were connecting to. So a macOS-only keyword such as
# UseKeychain cannot live in a tracked file even inside a Darwin-gated
# block, because this same file is stowed onto Linux and parsed there.
#
# Everything tracked here is therefore valid on both platforms. Anything
# platform- or machine-specific goes in ~/.dotoverrides/ssh/, which is not
# in git and is only present on the box that needs it.
#
# Check any change without connecting to anything:
#   ssh -G <host> | grep -iE 'identityagent|hashknownhosts'

# --- 1. Machine-local overrides, untracked. First seen, so strongest. -------
# Mirrors ~/.dotoverrides/gitconfig. A glob matching nothing is not an error,
# so boxes without the directory are fine.
Include ~/.dotoverrides/ssh/*.conf

# --- 2. Per-OS, mirroring the gitconfig-macos / gitconfig-linux split. ------
# phoenix and other Linux boxes.
Match exec "test \"$(uname -s)\" = Linux"
  Include ~/.ssh/config-linux

# The work laptop.
Match exec "test \"$(uname -s)\" = Darwin"
  Include ~/.ssh/config-macos

# --- 3. Shared defaults. Last, so anything above wins. ----------------------
Host *
  # Hash hostnames in known_hosts, so a copy of that file does not hand over
  # an inventory of everywhere you connect. Ubuntu already defaults to this;
  # macOS does not.
  HashKnownHosts yes

  # Notice a dead connection in ~3 minutes instead of hanging indefinitely.
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Deliberately NOT set here:
  #   IdentitiesOnly yes  — restricts ssh to keys named by IdentityFile. With
  #     the key held in 1Password and no IdentityFile on disk, that offers the
  #     server nothing and every connection fails publickey.
  #   AddKeysToAgent yes  — 1Password's agent does not accept added keys.
  #   ControlMaster auto  — wants a socket directory that must exist before
  #     the first connection; not worth stowing an empty directory for.
