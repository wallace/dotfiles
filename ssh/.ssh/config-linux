# Linux boxes — currently phoenix. Included from ~/.ssh/config when
# `uname -s` is Linux.
#
# Keep every keyword here valid on macOS too: this file is parsed on the work
# laptop even though the Match gate stops it applying there. See ~/.ssh/config.

# 1Password's SSH agent. The private key stays in the vault and each use is
# approved in 1Password, so nothing sensitive sits on disk — which matters
# more than usual while this machine has no full-disk encryption.
IdentityAgent ~/.1password/agent.sock
