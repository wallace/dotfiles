# Maps identities to the SSH keys allowed to sign for them, so that
# `git log --show-signature` can verify locally. Referenced by
# gpg.ssh.allowedSignersFile in ~/.gitconfig.
#
# Public keys only — nothing here is secret. The principal on the left
# must match the email git records on the commit, so a machine that
# commits under a work address needs its own line for that address.
#
# namespaces="git" scopes these keys to git signing, so the same key
# being usable for SSH login does not imply it may sign commits.

jonathan.wallace@gmail.com namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILqh7+ttaQbNKEoLCqvTArRxZgKpmI/I8Qda2GhWU+Tf
jonathan.wallace@gmail.com namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEYA6OYaSKjVDKpP4NNG/Y5KxuI5LGhyrU9qHnqfXmbU

