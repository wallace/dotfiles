# Outbound mail for neomutt. Reads the same Gmail App Password that mbsync
# uses, out of the login keyring.

account jonathanwallace
host smtp.gmail.com
port 587
protocol smtp
auth on
from jonathan.wallace@gmail.com
user jonathan.wallace@gmail.com
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt

# passwordeval, not `password`: msmtp refuses to read a file containing a
# literal password unless it is mode 600, and this file arrives by stow
# symlink out of a git checkout — git tracks only the executable bit, so the
# mode would be whatever the umask gave it. Keeping the secret out of the file
# sidesteps that entirely.
#
# Same keyring entry as .mbsyncrc, stored under the IMAP host: one App
# Password covers both protocols, so there is nothing gained by storing it
# twice.
passwordeval "secret-tool lookup account jonathan.wallace@gmail.com server imap.gmail.com"

account default : jonathanwallace
