# Vim plugins (managed by vim-plug)
vim/.vim/plugged/
vim/.vim/autoload/plug.vim

# Profiling
startup.log
.DS_Store

# issue-report: never commit fetched issue data or generated reports (may contain internal info)
issue-report*.md
issue-reports/data/
.cache/issue-reports/

# ---------------------------------------------------------------------------
# Secrets — never commit. A dotfiles repo is the classic place these leak from,
# because the files live in $HOME next to things you DO want tracked.
# ---------------------------------------------------------------------------
.ssh/
**/.ssh/

# One deliberate exception: the `ssh` stow package carries the SSH *client
# config*, which is not secret and has to be tracked for stow to place it.
# Re-include that directory, then immediately re-exclude everything inside it
# and allow back only the specific files by exact name. The re-exclusion is
# the point: a private key that ever lands in ssh/.ssh/ stays ignored, because
# nothing here matches it. Adding a new per-OS config means adding a line
# below — on purpose, not by a glob that quietly widens over time.
!ssh/.ssh/
ssh/.ssh/*
!ssh/.ssh/config
!ssh/.ssh/config-linux
!ssh/.ssh/config-macos
!ssh/.ssh/allowed_signers

id_rsa
id_ed25519
id_ecdsa
*.pem
*.key
*.ppk
known_hosts
authorized_keys

.gnupg/
**/.gnupg/
secring.*
*.private.gpg
*.private.asc
private-key*.asc

.aws/
.azure/
.kube/
.aws/credentials
**/.aws/credentials
.netrc
**/.netrc
.docker/config.json

*.env
.env
.env.*
!.env.example
!.env.sample
.envrc.local
*_token
*_secret
*apikey*
*api_key*
.dotoverrides/

# Local machine overrides. Deliberately narrow: this repo tracks
# bash/.bashrc.local and friends on purpose, so no blanket *.local rule.
*.secret.local
.env.local

