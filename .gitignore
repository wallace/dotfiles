# Provisioning run artifacts
dotfiles_install.log
ubuntu/*.AppImage
ubuntu/*.AppImage.sha256
ubuntu/*.deb

# rbenv installs Ruby versions, shims, and the active version marker into the
# stow package directory. These are machine-local build output (multi-GB), not
# configuration. rbenv/.rbenv/default-gems IS tracked — it is real config.
rbenv/.rbenv/versions/
rbenv/.rbenv/shims/
rbenv/.rbenv/version

# Claude Code's installer drops a launcher symlink into the copilot-cli stow
# package, pointing at a version-pinned absolute path under
# ~/.local/share/claude/versions/. It is machine-local and goes stale on every
# Claude update, so it is generated state rather than configuration.
copilot-cli/.local/bin/claude

# Mail working files. ~/.mutt is a stow symlink back into this repo, so
# neomutt's message cache and temp files land *inside the working tree*.
# Ignore the contents while keeping the directories themselves tracked --
# neomutt errors on startup if they do not exist.
mutt/.mutt/cache/bodies/*
!mutt/.mutt/cache/bodies/empty-file-for-git
mutt/.mutt/cache/headers/
mutt/.mutt/temp/*
!mutt/.mutt/temp/empty-file-for-git
# Written by `mutt_mailcap`/system mailcap probing at runtime, never by hand.
mutt/.mutt/mailcap

# Claude Code config. A global ignore rule (`.claude/` in ~/.config/git/ignore)
# exists to keep Claude's state out of every OTHER repo, but it also matches
# this stow package, so `git add claude/.claude/settings.json` is refused even
# though the file is already tracked. Repo .gitignore outranks the global one,
# so re-include the directory here.
#
# Same shape as the ssh/.ssh/ exception above, and for the same reason: git
# cannot re-include a file whose parent directory is excluded, so un-ignore the
# directory, immediately re-exclude everything in it, then allow back only what
# is really configuration. ~/.claude is a stow symlink into this repo, so
# Claude's entire runtime state -- session transcripts under projects/,
# history.jsonl, caches, and .credentials.json -- lives inside the working
# tree. The re-exclusion is what keeps those out, credentials included.
!claude/.claude/
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/skills/
