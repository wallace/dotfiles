# Build artifacts, caches, dependencies
# ---------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.gem
