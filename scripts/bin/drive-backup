#!/usr/bin/env bash
#
# drive-backup
#
# Copy Google Drive down to the external drive.
#
# `rclone copy`, deliberately not `rclone sync`. sync mirrors deletions, which
# would defeat the whole purpose: the point is to delete from Google to reclaim
# storage while keeping the local copy. copy only ever adds and updates. This
# is the same reasoning that made the mail archive channel drop mbsync's Gone
# operation -- a backup that faithfully reproduces your deletions is not a
# backup.
#
# Google-native files (Docs, Sheets, Slides) have no bytes to download, so they
# are exported to Office formats on the way out. Without this rclone skips them
# and the backup silently omits every document you actually wrote.
#
# Configuration:
#   DRIVE_BACKUP_REMOTE  rclone remote name (default: gdrive:)
#   DRIVE_BACKUP_DEST    staging directory (default: T9/gdrive)
#   MAIL_BACKUP_REPO     restic repository -- shared with mail-backup
#
# Set the remote up once with `rclone config` -- it needs a browser for OAuth.

set -euo pipefail

remote="${DRIVE_BACKUP_REMOTE:-gdrive:}"
dest="${DRIVE_BACKUP_DEST:-/run/media/$USER/T9/gdrive}"
parent=$(dirname "$dest")

if [ ! -d "$parent" ]; then
    echo "drive-backup: $parent not found -- is the external drive plugged in?" >&2
    exit 69  # EX_UNAVAILABLE
fi
if ! rclone listremotes | grep -qx "$remote"; then
    echo "drive-backup: remote '$remote' is not configured; run: rclone config" >&2
    exit 78  # EX_CONFIG
fi

mkdir -p "$dest"
log="$dest/.drive-backup.log"

# --fast-list trades memory for far fewer API calls on a large Drive, which
# matters because Google rate-limits per-request rather than per-byte.
# --drive-acknowledge-abuse stops the run aborting on files Google has flagged;
# they are still yours and still worth keeping.
rclone copy "$remote" "$dest" \
    --drive-export-formats docx,xlsx,pptx,svg,pdf \
    --drive-acknowledge-abuse \
    --fast-list \
    --transfers 8 \
    --checkers 16 \
    --retries 5 \
    --log-file "$log" \
    --log-level INFO \
    --stats 30s \
    --progress

# Second pass. Drive lets distinct files share a name inside one folder and a
# filesystem does not, so rclone keeps the first and logs "Duplicate object
# found in source - ignoring" for the rest. On this account that silently
# omitted 170 objects, 27 of them verified to differ in content from the copy
# that was kept. drive-dupes fetches those by file ID.
drive-dupes || echo "drive-backup: duplicate pass failed; see above" >&2

# Snapshot the staging copy into restic. The plain tree above stays -- it is
# what rclone diffs against next run, so re-copying 2.6 GB is avoided -- but
# plain files on a portable drive are readable by whoever picks it up, carry no
# history, and cannot be verified. restic supplies all three.
#
# Same repository as mail, distinguished by tag: content is deduplicated across
# both, one key unlocks both, and one `restic check` covers both. Retention is
# tag-scoped on each side, so neither prunes the other's snapshots.
if [ -n "${MAIL_BACKUP_REPO:-}" ] && [ -d "${MAIL_BACKUP_REPO}" ]; then
    echo
    echo "drive-backup: snapshotting into restic..."
    export RESTIC_REPOSITORY="$MAIL_BACKUP_REPO"
    export RESTIC_PASSWORD_COMMAND="secret-tool lookup service restic repo mail"

    # The log is excluded deliberately: it is rewritten every run and would add
    # a fresh copy to each snapshot while telling you nothing a snapshot does
    # not already record.
    restic backup "$dest" --tag drive --exclude "$log"

    restic forget --tag drive \
        --keep-daily 14 --keep-weekly 8 --keep-monthly 24 --prune
    restic check
else
    echo "drive-backup: MAIL_BACKUP_REPO unset or missing; skipping restic" >&2
fi

echo
echo "drive-backup: done. Log: $log"
rclone size "$dest" 2>/dev/null || true
